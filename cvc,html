            // Main Application Object
            const App = {
                data: JSON.parse(JSON.stringify(DEFAULT_CV_DATA)),
                autoSaveTimer: null,
                
                // Initialize Application
                init() {
                    this.loadFromLocalStorage();
                    this.renderAll();
                    this.setupEventListeners();
                    this.checkFirstVisit();
                    
                    // Show success message
                    setTimeout(() => {
                        Toast.success('CV Maker ready! Your data auto-saves every 1 second.');
                    }, 1000);
                },
                
                // Check if first visit
                checkFirstVisit() {
                    const visited = localStorage.getItem('shia_cv_visited');
                    if (!visited) {
                        document.getElementById('welcomeModal').classList.remove('hidden');
                        localStorage.setItem('shia_cv_visited', 'true');
                    }
                },
                
                hideWelcome() {
                    document.getElementById('welcomeModal').classList.add('hidden');
                },
                
                // Setup Event Listeners
                setupEventListeners() {
                    // Auto-save on any input
                    document.querySelectorAll('input, textarea, select').forEach(el => {
                        el.addEventListener('input', () => this.triggerAutoSave());
                    });
                    
                    // Handle before unload
                    window.addEventListener('beforeunload', (e) => {
                        if (this.hasUnsavedChanges()) {
                            e.preventDefault();
                            e.returnValue = 'You have unsaved changes. Are you sure you want to leave?';
                        }
                    });
                },
                
                // Check for unsaved changes
                hasUnsavedChanges() {
                    const saved = localStorage.getItem(STORAGE_KEY);
                    return saved !== JSON.stringify(this.data);
                },
                
                // Trigger auto-save
                triggerAutoSave() {
                    clearTimeout(this.autoSaveTimer);
                    this.autoSaveTimer = setTimeout(() => {
                        this.saveToLocalStorage(true);
                    }, AUTO_SAVE_DELAY);
                },
                
                // Save to localStorage
                saveToLocalStorage(silent = false) {
                    try {
                        localStorage.setItem(STORAGE_KEY, JSON.stringify(this.data));
                        if (!silent) {
                            Toast.success('CV saved successfully!');
                        }
                        return true;
                    } catch (error) {
                        Toast.error('Failed to save: ' + error.message);
                        return false;
                    }
