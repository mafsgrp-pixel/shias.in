                                <div class="item-header">
                                    <span class="item-title">${this.escapeHtml(exp.title)}</span>
                                    <div class="item-actions">
                                        <button class="item-btn move" onclick="app.moveExperienceUp('${exp.id}')" ${index === 0 ? 'disabled' : ''}>
