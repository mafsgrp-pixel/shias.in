                                            <i class="fas fa-arrow-down"></i>
                                        </button>
                                        <button class="item-btn" onclick="app.removeSkill(${index})">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </div>
                                <input type="text" class="form-control" value="${this.escapeHtml(skill)}" oninput="app.updateSkill(${index}, this.value)">
