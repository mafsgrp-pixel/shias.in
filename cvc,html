                // Load from localStorage
                loadFromLocalStorage() {
                    try {
                        const saved = localStorage.getItem(STORAGE_KEY);
                        if (saved) {
                            this.data = JSON.parse(saved);
                            this.renderAll();
                            Toast.success('CV loaded successfully!');
                        } else {
                            Toast.info('No saved CV found. Using default template.');
                        }
                    } catch (error) {
                        Toast.error('Failed to load saved data');
                        this.resetToDefault();
                    }
                },
                
                // Reset to default
                resetToDefault() {
                    if (confirm('Are you sure? This will erase all your current data.')) {
                        this.data = JSON.parse(JSON.stringify(DEFAULT_CV_DATA));
                        this.renderAll();
                        Toast.success('Reset to default template');
                    }
                },
                
                // Update personal info
                updatePersonal(field, value) {
                    this.data.personal[field] = value;
                    this.renderPreview();
                },
                
                // Skills Management
                addSkill() {
                    const newSkill = prompt('Enter skill name:');
                    if (newSkill && newSkill.trim()) {
                        this.data.skills.push(newSkill.trim());
                        this.renderSkills();
                        this.renderPreview();
                        Toast.success('Skill added');
                    }
                },
                
                updateSkill(index, value) {
                    this.data.skills[index] = value;
                    this.renderPreview();
                },
                
                removeSkill(index) {
                    if (confirm('Remove this skill?')) {
                        this.data.skills.splice(index, 1);
                        this.renderSkills();
                        this.renderPreview();
                        Toast.success('Skill removed');
                    }
                },
                
                moveSkillUp(index) {
                    if (index > 0) {
                        [this.data.skills[index - 1], this.data.skills[index]] = 
                        [this.data.skills[index], this.data.skills[index - 1]];
                        this.renderSkills();
                        this.renderPreview();
                    }
                },
                
                moveSkillDown(index) {
                    if (index < this.data.skills.length - 1) {
                        [this.data.skills[index], this.data.skills[index + 1]] = 
                        [this.data.skills[index + 1], this.data.skills[index]];
                        this.renderSkills();
                        this.renderPreview();
                    }
                },
                
                // Experience Management
                addExperience() {
                    const newExp = {
                        id: 'exp' + Date.now() + Math.random(),
                        title: 'New Position',
                        company: 'Company Name',
                        startDate: '2024',
