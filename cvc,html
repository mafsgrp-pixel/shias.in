<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Advanced CV Maker · Shia Community · Production Version</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #0e2a38;
            --primary-light: #1e3f50;
            --primary-dark: #071a23;
            --accent: #ffb05c;
            --gray-50: #f8fafc;
            --gray-100: #f1f5f9;
            --gray-200: #e2e8f0;
            --gray-300: #cbd5e1;
            --gray-400: #94a3b8;
            --gray-500: #64748b;
            --gray-600: #475569;
            --gray-700: #334155;
            --gray-800: #1e293b;
            --gray-900: #0f172a;
            --success: #059669;
            --danger: #dc2626;
            --warning: #d97706;
            --info: #2563eb;
            --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
            --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1);
            --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1);
            --shadow-xl: 0 20px 25px -5px rgb(0 0 0 / 0.1);
            --radius-sm: 0.375rem;
            --radius-md: 0.5rem;
            --radius-lg: 1rem;
            --radius-xl: 1.5rem;
            --radius-full: 9999px;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 1rem;
        }

        /* Toast Notifications */
        .toast-container {
            position: fixed;
            top: 1rem;
            right: 1rem;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .toast {
            background: white;
            color: var(--gray-900);
            padding: 1rem 1.5rem;
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-xl);
            display: flex;
            align-items: center;
            gap: 0.75rem;
            min-width: 300px;
            max-width: 400px;
            animation: slideIn 0.3s ease;
            border-left: 4px solid;
        }

        .toast.success { border-left-color: var(--success); }
        .toast.error { border-left-color: var(--danger); }
        .toast.warning { border-left-color: var(--warning); }
        .toast.info { border-left-color: var(--info); }

        .toast i {
            font-size: 1.25rem;
        }

        .toast.success i { color: var(--success); }
        .toast.error i { color: var(--danger); }
        .toast.warning i { color: var(--warning); }
        .toast.info i { color: var(--info); }

        .toast-content {
            flex: 1;
        }

        .toast-title {
            font-weight: 600;
            margin-bottom: 0.25rem;
        }

        .toast-message {
            font-size: 0.875rem;
            color: var(--gray-600);
        }

        .toast-close {
            background: none;
            border: none;
            color: var(--gray-400);
            cursor: pointer;
            font-size: 1.25rem;
            padding: 0.25rem;
            transition: color 0.2s;
        }

        .toast-close:hover {
            color: var(--gray-600);
        }

        @keyframes slideIn {
            from {
                transform: translateX(100%);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        /* Main App */
        .app-container {
            max-width: 1600px;
            margin: 0 auto;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: var(--radius-xl);
            box-shadow: var(--shadow-xl);
            overflow: hidden;
        }

        /* Header */
        .app-header {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
            color: white;
            padding: 1.5rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .header-title {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .header-title h1 {
            font-size: 1.875rem;
            font-weight: 700;
        }

        .header-title i {
            color: var(--accent);
            font-size: 2rem;
        }

        .header-badge {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(5px);
            padding: 0.5rem 1.5rem;
            border-radius: var(--radius-full);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-weight: 500;
        }

        .header-actions {
            display: flex;
            gap: 0.75rem;
        }

        .header-btn {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: white;
            padding: 0.75rem 1.5rem;
            border-radius: var(--radius-full);
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .header-btn:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: translateY(-2px);
        }

        /* Main Layout */
        .main-layout {
            display: grid;
            grid-template-columns: 400px 1fr;
            height: calc(100vh - 100px);
            overflow: hidden;
        }

        /* Sidebar */
        .sidebar {
            background: var(--gray-50);
            border-right: 1px solid var(--gray-200);
            overflow-y: auto;
            padding: 1.5rem;
            scrollbar-width: thin;
            scrollbar-color: var(--gray-400) var(--gray-100);
        }

        .sidebar::-webkit-scrollbar {
            width: 8px;
        }

        .sidebar::-webkit-scrollbar-track {
            background: var(--gray-100);
        }

        .sidebar::-webkit-scrollbar-thumb {
            background: var(--gray-400);
            border-radius: var(--radius-full);
        }

        /* Editor Sections */
        .editor-section {
            background: white;
            border-radius: var(--radius-lg);
            padding: 1.5rem;
            margin-bottom: 1.5rem;
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--gray-200);
        }

        .editor-section h2 {
            font-size: 1.25rem;
            font-weight: 600;
            color: var(--gray-900);
            margin-bottom: 1.25rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding-bottom: 0.75rem;
            border-bottom: 2px solid var(--gray-200);
        }

        .editor-section h2 i {
            color: var(--primary);
        }

        /* Form Controls */
        .form-group {
            margin-bottom: 1rem;
        }

        .form-group label {
            display: block;
            font-size: 0.875rem;
            font-weight: 500;
            color: var(--gray-700);
            margin-bottom: 0.375rem;
        }

        .form-control {
            width: 100%;
            padding: 0.75rem 1rem;
            border: 2px solid var(--gray-200);
            border-radius: var(--radius-md);
            font-size: 0.95rem;
            transition: all 0.2s;
            font-family: 'Inter', sans-serif;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(14, 42, 56, 0.1);
        }

        textarea.form-control {
            min-height: 100px;
            resize: vertical;
        }

        /* Dynamic Items */
        .dynamic-items {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .dynamic-item {
            background: var(--gray-50);
            border-radius: var(--radius-md);
            padding: 1rem;
            border: 1px solid var(--gray-200);
            transition: all 0.2s;
        }

        .dynamic-item:hover {
            border-color: var(--primary);
            box-shadow: var(--shadow-md);
        }

        .item-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 0.75rem;
        }

        .item-title {
            font-weight: 600;
            color: var(--gray-700);
            font-size: 0.875rem;
        }

        .item-actions {
            display: flex;
            gap: 0.5rem;
        }

        .item-btn {
            background: none;
            border: none;
            color: var(--gray-500);
            cursor: pointer;
            padding: 0.25rem;
            font-size: 1rem;
            transition: all 0.2s;
        }

        .item-btn:hover {
            color: var(--danger);
        }

        .item-btn.move:hover {
            color: var(--info);
        }

        .add-btn {
            width: 100%;
            padding: 0.75rem;
            background: var(--gray-100);
            border: 2px dashed var(--gray-300);
            border-radius: var(--radius-md);
            color: var(--gray-600);
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .add-btn:hover {
            background: var(--gray-200);
            border-color: var(--primary);
            color: var(--primary);
        }

        /* Grid Layout for Forms */
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.75rem;
            margin-bottom: 0.75rem;
        }

        /* Color Picker */
        .color-picker {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
            margin: 1rem 0;
        }

        .color-option {
            width: 40px;
            height: 40px;
            border-radius: var(--radius-full);
            cursor: pointer;
            border: 3px solid transparent;
            transition: all 0.2s;
        }

        .color-option:hover {
            transform: scale(1.1);
        }

        .color-option.active {
            border-color: var(--gray-900);
            box-shadow: var(--shadow-md);
        }

        /* Template Options */
        .template-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 0.75rem;
            margin: 1rem 0;
        }

        .template-option {
            padding: 1rem;
            text-align: center;
            background: var(--gray-100);
            border: 2px solid transparent;
            border-radius: var(--radius-md);
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
        }

        .template-option:hover {
            background: var(--gray-200);
        }

        .template-option.active {
            background: var(--primary);
            color: white;
            border-color: var(--primary-dark);
        }

        /* Toggle Switches */
        .toggle-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.75rem 0;
            border-bottom: 1px solid var(--gray-200);
        }

        .toggle-item:last-child {
            border-bottom: none;
        }

        .toggle-switch {
            position: relative;
            display: inline-block;
            width: 52px;
            height: 28px;
        }

        .toggle-switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

        .toggle-slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: var(--gray-300);
            transition: 0.2s;
            border-radius: 34px;
        }

        .toggle-slider:before {
            position: absolute;
            content: "";
            height: 22px;
            width: 22px;
            left: 3px;
            bottom: 3px;
            background-color: white;
            transition: 0.2s;
            border-radius: 50%;
        }

        input:checked + .toggle-slider {
            background-color: var(--primary);
        }

        input:checked + .toggle-slider:before {
            transform: translateX(24px);
        }

        /* Preview Area */
        .preview-area {
            padding: 2rem;
            overflow-y: auto;
            background: var(--gray-100);
        }

        .cv-preview {
            background: white;
            border-radius: var(--radius-xl);
            padding: 3rem;
            box-shadow: var(--shadow-lg);
            max-width: 900px;
            margin: 0 auto;
            transition: all 0.3s;
        }

        /* CV Templates */
        .template-modern .cv-header {
            text-align: center;
            margin-bottom: 2rem;
        }

        .template-classic .cv-header {
            border-bottom: 2px solid;
            padding-bottom: 1rem;
            margin-bottom: 2rem;
        }

        .template-professional .cv-header {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
            color: white;
            margin: -2rem -2rem 2rem -2rem;
            padding: 2rem;
            border-radius: var(--radius-xl) var(--radius-xl) 0 0;
        }

        .template-professional .cv-contact span {
            color: white;
        }

        .template-creative .cv-header {
            position: relative;
            padding-left: 2rem;
            margin-bottom: 2rem;
        }

        .template-creative .cv-header::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 4px;
            background: var(--primary);
            border-radius: var(--radius-full);
        }

        .cv-name {
            font-size: 3rem;
            font-weight: 700;
            line-height: 1.2;
            margin-bottom: 0.5rem;
        }

        .cv-title {
            font-size: 1.5rem;
            color: var(--gray-600);
            margin-bottom: 1.5rem;
            font-weight: 500;
        }

        .cv-contact {
            display: flex;
            flex-wrap: wrap;
            gap: 1.5rem;
            justify-content: center;
            margin-bottom: 2rem;
        }

        .cv-contact span {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--gray-600);
        }

        .cv-section {
            margin-bottom: 2rem;
        }

        .section-title {
            font-size: 1.5rem;
            font-weight: 600;
            border-bottom: 3px solid;
            padding-bottom: 0.5rem;
            margin-bottom: 1rem;
        }

        .skill-tag {
            display: inline-block;
            background: var(--gray-100);
            padding: 0.5rem 1rem;
            margin: 0 0.5rem 0.5rem 0;
            border-radius: var(--radius-full);
            font-size: 0.875rem;
            border-left: 3px solid;
        }

        .exp-item {
            margin-bottom: 1.5rem;
        }

        .exp-header {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 0.5rem;
        }

        .exp-title {
            font-weight: 600;
            font-size: 1.125rem;
        }

        .exp-company {
            background: var(--gray-100);
            padding: 0.25rem 1rem;
            border-radius: var(--radius-full);
            font-weight: 500;
        }

        .exp-date {
            color: var(--gray-500);
            font-size: 0.875rem;
            margin-bottom: 0.5rem;
        }

        /* Loading Overlay */
        .loading-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(5px);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 10000;
        }

        .loading-overlay.active {
            display: flex;
        }

        .loading-card {
            background: white;
            padding: 2rem;
            border-radius: var(--radius-xl);
            text-align: center;
            box-shadow: var(--shadow-xl);
        }

        .loading-spinner {
            width: 50px;
            height: 50px;
            border: 4px solid var(--gray-200);
            border-top-color: var(--primary);
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin: 0 auto 1rem;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        /* Welcome Modal */
        .welcome-modal {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(5px);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 10001;
        }

        .welcome-modal.hidden {
            display: none;
        }

        .welcome-card {
            background: white;
            padding: 3rem;
            border-radius: var(--radius-xl);
            text-align: center;
            max-width: 500px;
            width: 90%;
            animation: popIn 0.5s ease;
        }

        @keyframes popIn {
            from {
                transform: scale(0.9);
                opacity: 0;
            }
            to {
                transform: scale(1);
                opacity: 1;
            }
        }

        .welcome-icon {
            width: 100px;
            height: 100px;
            background: var(--gray-100);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 2rem;
            font-size: 3rem;
            color: var(--primary);
        }

        .welcome-card h2 {
            font-size: 2rem;
            color: var(--gray-900);
            margin-bottom: 1rem;
        }

        .welcome-card p {
            color: var(--gray-600);
            margin-bottom: 1rem;
            line-height: 1.6;
        }

        .welcome-features {
            background: var(--gray-50);
            padding: 1.5rem;
            border-radius: var(--radius-lg);
            margin: 2rem 0;
            text-align: left;
        }

        .welcome-features li {
            list-style: none;
            margin-bottom: 0.75rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .welcome-features i {
            color: var(--success);
        }

        .welcome-btn {
            background: var(--primary);
            color: white;
            border: none;
            padding: 1rem 2rem;
            border-radius: var(--radius-full);
            font-size: 1.125rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            width: 100%;
        }

        .welcome-btn:hover {
            background: var(--primary-light);
            transform: translateY(-2px);
        }

        /* Print Styles */
        @media print {
            body * {
                visibility: hidden;
            }
            .cv-preview,
            .cv-preview * {
                visibility: visible;
            }
            .cv-preview {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
                padding: 1in;
                box-shadow: none;
            }
        }

        /* Responsive */
        @media (max-width: 1024px) {
            .main-layout {
                grid-template-columns: 350px 1fr;
            }
        }

        @media (max-width: 768px) {
            .main-layout {
                grid-template-columns: 1fr;
                height: auto;
            }
            .sidebar {
                max-height: 500px;
            }
            .cv-name {
                font-size: 2rem;
            }
            .cv-title {
                font-size: 1.25rem;
            }
        }
    </style>
</head>
<body>
    <!-- Welcome Modal -->
    <div class="welcome-modal" id="welcomeModal">
        <div class="welcome-card">
            <div class="welcome-icon">
                <i class="fas fa-hands-helping"></i>
            </div>
            <h2>🌙 Shia Community CV Maker</h2>
            <p>Professional CV builder designed for the Shia community</p>
            <div class="welcome-features">
                <li><i class="fas fa-check-circle"></i> 100% Free - No hidden costs</li>
                <li><i class="fas fa-check-circle"></i> Privacy First - Data stays on your device</li>
                <li><i class="fas fa-check-circle"></i> Multiple Export Formats - PDF, DOCX, HTML</li>
                <li><i class="fas fa-check-circle"></i> Real-time Preview - See changes instantly</li>
                <li><i class="fas fa-check-circle"></i> Auto-save - Never lose your work</li>
                <li><i class="fas fa-check-circle"></i> RTL Support - For Arabic/Urdu CVs</li>
            </div>
            <button class="welcome-btn" onclick="app.hideWelcome()">Start Building →</button>
        </div>
    </div>

    <!-- Toast Container -->
    <div class="toast-container" id="toastContainer"></div>

    <!-- Loading Overlay -->
    <div class="loading-overlay" id="loadingOverlay">
        <div class="loading-card">
            <div class="loading-spinner"></div>
            <div id="loadingMessage">Processing...</div>
        </div>
    </div>

    <!-- Main App -->
    <div class="app-container">
        <!-- Header -->
        <header class="app-header">
            <div class="header-title">
                <i class="fas fa-hands-helping"></i>
                <h1>CV Maker · Shia Community</h1>
            </div>
            <div class="header-badge">
                <i class="fas fa-shield-alt"></i>
                <span>Privacy First · No Data Storage</span>
            </div>
            <div class="header-actions">
                <button class="header-btn" onclick="app.saveToLocalStorage()">
                    <i class="fas fa-save"></i>
                    <span>Save</span>
                </button>
                <button class="header-btn" onclick="app.loadFromLocalStorage()">
                    <i class="fas fa-folder-open"></i>
                    <span>Load</span>
                </button>
                <button class="header-btn" onclick="app.resetToDefault()">
                    <i class="fas fa-undo"></i>
                    <span>Reset</span>
                </button>
            </div>
        </header>

        <!-- Main Layout -->
        <div class="main-layout">
            <!-- Sidebar Editor -->
            <aside class="sidebar" id="sidebar">
                <!-- Personal Info -->
                <section class="editor-section" data-section="personal">
                    <h2><i class="fas fa-user"></i> Personal Information</h2>
                    <div class="form-group">
                        <label>Full Name *</label>
                        <input type="text" class="form-control" id="fullName" placeholder="Rahil Abbas Rizvi" oninput="app.updatePersonal('name', this.value)">
                    </div>
                    <div class="form-group">
                        <label>Professional Title *</label>
                        <input type="text" class="form-control" id="title" placeholder="Web Analyst & Digital Marketing Trainer" oninput="app.updatePersonal('title', this.value)">
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Email *</label>
                            <input type="email" class="form-control" id="email" placeholder="email@example.com" oninput="app.updatePersonal('email', this.value)">
                        </div>
                        <div class="form-group">
                            <label>Phone</label>
                            <input type="tel" class="form-control" id="phone" placeholder="+91 12345 67890" oninput="app.updatePersonal('phone', this.value)">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Location</label>
                            <input type="text" class="form-control" id="location" placeholder="Mumbai, India" oninput="app.updatePersonal('location', this.value)">
                        </div>
                        <div class="form-group">
                            <label>LinkedIn</label>
                            <input type="text" class="form-control" id="linkedin" placeholder="linkedin.com/in/username" oninput="app.updatePersonal('linkedin', this.value)">
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Professional Summary</label>
                        <textarea class="form-control" id="summary" rows="4" oninput="app.updatePersonal('summary', this.value)"></textarea>
                    </div>
                </section>

                <!-- Skills -->
                <section class="editor-section" data-section="skills">
