                // Export Functions
                async exportAsPDF() {
                    Loading.show('Generating PDF...');
                    
                    try {
                        const element = document.getElementById('cvPreview');
                        
                        // Clone for PDF
                        const clone = element.cloneNode(true);
                        clone.style.width = '800px';
                        clone.style.padding = '40px';
                        clone.style.background = 'white';
                        
                        // Create canvas
                        const canvas = await html2canvas(clone, {
                            scale: 2,
                            backgroundColor: '#ffffff',
                            logging: false,
                            allowTaint: false,
                            useCORS: true
                        });
                        
                        // Create PDF
                        const { jsPDF } = window.jspdf;
                        const pdf = new jsPDF({
                            orientation: 'portrait',
                            unit: 'px',
                            format: 'a4'
                        });
                        
                        const imgData = canvas.toDataURL('image/png');
                        const pdfWidth = pdf.internal.pageSize.getWidth();
                        const pdfHeight = pdf.internal.pageSize.getHeight();
                        
                        const ratio = Math.min(pdfWidth / canvas.width, pdfHeight / canvas.height);
                        const width = canvas.width * ratio;
                        const height = canvas.height * ratio;
                        
                        const xOffset = (pdfWidth - width) / 2;
                        const yOffset = (pdfHeight - height) / 2;
                        
                        pdf.addImage(imgData, 'PNG', xOffset, yOffset, width, height);
                        
                        // Save with proper filename
                        const filename = `${this.data.personal.name.replace(/\s+/g, '_')}_CV.pdf`;
                        pdf.save(filename);
                        
                        Loading.hide();
                        Toast.success('PDF generated successfully!');
                    } catch (error) {
                        console.error('PDF Error:', error);
                        Loading.hide();
                        Toast.error('Failed to generate PDF. Trying fallback...');
                        this.fallbackPrintPDF();
                    }
                },
                
                fallbackPrintPDF() {
                    const printWindow = window.open('', '_blank');
                    const styles = document.querySelector('style').innerHTML;
                    const preview = document.getElementById('cvPreview').cloneNode(true);
                    
                    printWindow.document.write(`
